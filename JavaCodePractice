    public static int lengthOfLongestSubstring(String s) {
           int maxLen = 0;
           int right = 0,left = 0;
           HashSet<Character> charSet = new HashSet<>();
           int n = s.length();
           while (right < n) {
               char c = s.charAt(right);
               if(!charSet.contains(c)) {
                   charSet.add(c);
                   maxLen = Math.max(maxLen, right-left+1);
                   right ++;
               } else {
                   charSet.remove(c);
                   left++;
               }
           }
            return maxLen;
        }



