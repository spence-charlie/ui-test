    public static int[] twoSum(int[] nums, int target) {

        int len = nums.length;
        Map<Integer, Integer> mapp = new HashMap<Integer, Integer>();
        for (int i = 0; i < len; i++) {
            int diff = target - nums[i];
            if (mapp.containsKey(diff)) {
                return new int[]{mapp.get(diff), i};
            }
            mapp.put(nums[i], i);
        }
        return new int[]{};
    }

