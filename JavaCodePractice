    public List<List<Integer>> threeSumsQues(int[] nums) {

        Set<Integer> zArr = new HashSet<>();
        Set<Integer> pArr = new HashSet<>();
        Set<Integer> nArr = new HashSet<>();
        Set<List<Integer>> result = new HashSet<>();

        for (int i = 0; i < nums.length; i++) {
            if (nums[i] < 0) {
                nArr.add(nums[i]);
            }
            if (nums[i] > 0) {
                pArr.add(nums[i]);
            }
            if (nums[i] == 0) {
                zArr.add(nums[i]);
            }
        }

        if (zArr.size() != 0) {
            if (zArr.size() >= 3) {
                result.add(Arrays.asList(0, 0, 0));
            }

            for (int pos : pArr) {
                if (nArr.contains(-pos)) {
                    result.add(Arrays.asList(-pos, 0, pos));
                }
            }

        } else {
            List<Integer> poArr = new ArrayList<>(pArr);
            List<Integer> neArr = new ArrayList<>(nArr);

            for (int i = 0; i < poArr.size(); i++) {
                for (int j = i + 1; j < poArr.size(); j++) {
                    int sum = (int) poArr.get(i) + (int) poArr.get(j);
                    if (nArr.contains(-1 * sum)) {
                        result.add(Arrays.asList((int) poArr.get(i), (int) poArr.get(j), -1 * sum));
                    }
                }
            }

            for (int i = 0; i < neArr.size(); i++) {
                for (int j = i + 1; j < neArr.size(); j++) {
                    int sum = (int) neArr.get(i) + (int) neArr.get(j);
                    if (pArr.contains(-1 * sum)) {
                        result.add(Arrays.asList((int) neArr.get(i), (int) neArr.get(j), -1 * sum));
                    }
                }
            }


        }
        return new ArrayList<>(result);
    }

    public static String simplifyPath(String path) {


        String[] newPath = path.split("/");

        String newString = new String();
        Stack<String> strStack = new Stack<>();

        for (int i = 0; i < newPath.length; i++) {

            if(newPath[i].equals(".") || newPath[i].equals("")){
             //   i++;
                continue;
            } else {
                if(!newPath[i].equals("..")){
                    strStack.push("/"+ newPath[i]);
                } else {
                    if(strStack.size()!=0){
                        strStack.pop();
                    }
                }
            }

        }

        while(!strStack.isEmpty()){
            String tempStr = strStack.pop();
            newString = tempStr.concat(newString);
        }

        if(newString.isEmpty()){
            return "/";
        } else return newString;
    }

