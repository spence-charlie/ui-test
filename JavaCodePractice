    public static List<Integer> validateRequests(List<String> blacklisted_ips, List<String> requests) {
        // Write your code here
        List<Integer> result = new ArrayList<Integer>();

        List<Pattern> compiledPatterns = new ArrayList<Pattern>();

        for(String pattern : blacklisted_ips){
            String regex = pattern.replace(".", "\\.").replace("*", ".*");
            compiledPatterns.add(Pattern.compile(regex));
        }

        Map<String, LinkedList<Integer>> ipHistory = new HashMap<String, LinkedList<Integer>>();

        for(int time=0; time< requests.size(); time++){
            String ip = requests.get(time);
            boolean isBlocked = false;

            for(Pattern pattern : compiledPatterns){
                if(pattern.matcher(ip).matches()){
                    isBlocked = true;
                    break;
                }
            }

            if(!isBlocked){
                LinkedList<Integer> times = ipHistory.getOrDefault(ip, new LinkedList<Integer>());

                while(!times.isEmpty() && time- times.peekFirst() >= 5) {
                    times.pollFirst();
                }

                if(times.size() >=2) {
                    isBlocked = true;
                } else {
                    times.add(time);
                    ipHistory.put(ip, times);
                }
            }

            result.add(isBlocked?1:0);

        }

        return result;


    }

