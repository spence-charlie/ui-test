    public int[] asteroidCollision(int[] asteroids) {

        Stack<Integer> colStack = new Stack<>();
        for(int a : asteroids){
            if(a > 0) {
                colStack.push(a);
            } else {
                while( !colStack.isEmpty() && colStack.peek() >0 && colStack.peek() < -a) {
                    colStack.pop();
                }
                if(colStack.isEmpty() || colStack.peek() <0){
                    colStack.push(a);
                }
                if(colStack.peek() == -a){
                    colStack.pop();
                }
            }
        }
        int[] result = new int[colStack.size()];
        for(int i=colStack.size()-1; i>=0; i--){
            result[i] = colStack.pop();
        }

        return result;
    }

