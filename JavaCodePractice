    public static int minSwaps(String s) {
        int totalZero =0;
        int totalOne =0;
        for(int i=0 ; i<s.length(); i++){
            if(s.charAt(i)=='1'){
                totalOne++;
            } else {
                totalZero++;
            }
        }

        if(Math.abs(totalOne - totalZero) >1) return -1;

        int missZero =0;
        int missOne =0;
        for(int i=0 ; i<s.length() ; i+=2){
            if(s.charAt(i)!='0'){
                missZero++;
            } else missOne++;
        }

        if ((totalOne - totalZero) == 0) return Math.min(missOne, missZero);
        else return totalOne > totalZero? missOne : missZero;
    }




