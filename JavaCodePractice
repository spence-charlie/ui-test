    public static boolean isValidParantheses(String s) {

        //Character[] stackArray = new Character[]{};

        Stack<Character> stackArr = new Stack<>();
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            switch (c) {
                case '{':
                case '(':
                case '[':
                    stackArr.push(c);
                    break;
                case '}':
                    if (stackArr != null || stackArr.peek() == '{') {
                        stackArr.pop();
                    } else {
                        return false;
                    }
                    break;
                case ')':
                    if (stackArr != null || stackArr.peek() == '{') {
                        stackArr.pop();
                    } else return false;
                    break;
                case ']':
                    if (stackArr != null || stackArr.peek() == '[') {
                        stackArr.pop();
                    } else return false;
                    break;
            }
        }
        return stackArr.size() == 0;
    }


