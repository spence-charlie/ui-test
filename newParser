package main

import (
	"encoding/json"
	"fmt"
	"io/ioutil"
	"os"
	"path/filepath"
	"regexp"
	"strings"
	"time"

	"golang.org/x/net/html"
)

type InfrastructureData struct {
	AimID        string                                   `json:"aimId"`
	SectionName  string                                   `json:"sectionName"`
	SectionType  string                                   `json:"sectionType"`
	LastUpdated  time.Time                                `json:"lastUpdated"`
	Applications map[string]map[string]interface{}        `json:"applications"`
	Data         map[string]map[string][]RowEntry         `json:"data"`
}

type RowEntry struct {
	RowKey         string                   `json:"rowKey"`
	IsGeneratedKey bool                     `json:"isGeneratedKey"`
	Data           []map[string]interface{} `json:"data"`
}

func main() {
	if len(os.Args) < 2 {
		fmt.Println("Usage: go run main.go <html_file>")
		os.Exit(1)
	}
	htmlFile := os.Args[1]

	content, err := ioutil.ReadFile(htmlFile)
	if err != nil {
		panic(err)
	}
	doc, err := html.Parse(strings.NewReader(string(content)))
	if err != nil {
		panic(err)
	}

	tables := findTables(doc)

	results := []InfrastructureData{}
	counter := 1

	for _, tbl := range tables {
		appName := detectApplicationName(tbl)
		if appName == "" {
			appName = fmt.Sprintf("app_%d", counter)
		}
		counter++

		section := InfrastructureData{
			AimID:        fmt.Sprintf("AIM_%d", counter),
			SectionName:  appName,
			SectionType:  "infrastructure_matrix",
			LastUpdated:  time.Now(),
			Applications: map[string]map[string]interface{}{appName: {}},
			Data:         map[string]map[string][]RowEntry{},
		}

		envHeaders, rows := parseTable(tbl)
		section.Data["general"] = make(map[string][]RowEntry)

		for _, row := range rows {
			rowKey := row[0]
			for i, env := range envHeaders {
				if i+1 < len(row) {
					cell := strings.TrimSpace(row[i+1])
					if cell == "" {
						continue
					}
					entry := RowEntry{
						RowKey:         rowKey,
						IsGeneratedKey: false,
						Data:           []map[string]interface{}{parseCell(cell)},
					}
					section.Data["general"][env] = append(section.Data["general"][env], entry)
				}
			}
		}

		results = append(results, section)
	}

	outputDir := "./parsed_output"
	_ = os.MkdirAll(outputDir, 0755)
	combinedPath := filepath.Join(outputDir, "combined.json")
	data, _ := json.MarshalIndent(results, "", "  ")
	_ = ioutil.WriteFile(combinedPath, data, 0644)

	fmt.Println("✅ Parsing completed. Output:", combinedPath)
}

func findTables(n *html.Node) []*html.Node {
	var tables []*html.Node
	var walker func(*html.Node)
	walker = func(n *html.Node) {
		if n.Type == html.ElementNode && n.Data == "table" {
			tables = append(tables, n)
		}
		for c := n.FirstChild; c != nil; c = c.NextSibling {
			walker(c)
		}
	}
	walker(n)
	return tables
}

func getTextContent(n *html.Node) string {
	if n.Type == html.TextNode {
		return n.Data
	}
	var b strings.Builder
	for c := n.FirstChild; c != nil; c = c.NextSibling {
		b.WriteString(getTextContent(c))
	}
	return b.String()
}

func detectApplicationName(table *html.Node) string {
	for p := table.PrevSibling; p != nil; p = p.PrevSibling {
		if p.Type == html.ElementNode && (p.Data == "h1" || p.Data == "h2" || p.Data == "b") {
			txt := strings.TrimSpace(getTextContent(p))
			if txt != "" {
				return strings.ReplaceAll(strings.ToLower(txt), " ", "_")
			}
		}
	}
	return ""
}

func parseTable(table *html.Node) ([]string, [][]string) {
	var rows [][]string
	for tr := table.FirstChild; tr != nil; tr = tr.NextSibling {
		if tr.Type == html.ElementNode && tr.Data == "tr" {
			var row []string
			for td := tr.FirstChild; td != nil; td = td.NextSibling {
				if td.Type == html.ElementNode && (td.Data == "td" || td.Data == "th") {
					row = append(row, strings.TrimSpace(getTextContent(td)))
				}
			}
			if len(row) > 0 {
				rows = append(rows, row)
			}
		}
	}
	if len(rows) == 0 {
		return nil, nil
	}
	envHeaders := rows[0][1:]
	return envHeaders, rows[1:]
}

func parseCell(text string) map[string]interface{} {
	result := make(map[string]interface{})

	// Extract IPs
	ipRegex := regexp.MustCompile(`\b\d{1,3}(\.\d{1,3}){3}\b`)
	if ips := ipRegex.FindAllString(text, -1); len(ips) > 0 {
		if len(ips) == 1 {
			result["ip"] = ips[0]
		} else {
			result["ips"] = ips
		}
	}

	// Extract port
	portRegex := regexp.MustCompile(`:(\d{2,5})\b`)
	if matches := portRegex.FindStringSubmatch(text); len(matches) > 1 {
		result["port"] = matches[1]
	}

	// Extract hostname
	hostRegex := regexp.MustCompile(`[a-zA-Z0-9\-\.]+\.[a-zA-Z]{2,}`)
	if host := hostRegex.FindString(text); host != "" {
		result["hostname"] = host
	}

	// If nothing parsed, fallback to description
	if len(result) == 0 {
		result["description"] = text
	}
	return result
}
